<style>
  .smilu-buybox-wrapper {
    background: #FFFFFF;
    box-shadow: 0 10px 40px rgba(0,0,0,0.05);
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 16px;
    padding: 24px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .smilu-buybox-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .smilu-bb-title {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-size: 1.6rem !important;
    font-weight: 900 !important;
    color: #0B2033 !important;
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .smilu-bb-promise {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    color: #475569 !important;
    margin: 6px 0 0;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .smilu-bb-price {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    color: #0B2033 !important;
  }

  .smilu-bb-stock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 59, 48, 0.1);
    padding: 6px 12px;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #FF3B30 !important;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #FF3B30;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(255, 59, 48, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 59, 48, 0); }
  }

  .smilu-mp-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 158, 227, 0.1);
    border: 1px solid rgba(0, 158, 227, 0.2);
    padding: 12px;
    border-radius: 8px;
  }

  .smilu-mp-text {
    font-size: 0.85rem;
    color: #0B2033 !important;
    font-weight: 600;
  }

  .smilu-mp-text span {
    color: #00C97B !important;
  }

  .smilu-shipping-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(0, 0, 0, 0.02);
    padding: 12px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #0B2033 !important;
  }

  .smilu-dual-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--sm-brand-cyan, #00C2FF) !important;
    color: #FFFFFF !important;
    border: none;
    border-radius: 100px;
    padding: 18px 24px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
    width: 100%;
  }

  .smilu-dual-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 194, 255, 0.3);
  }

  .cta-title {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-size: 1.1rem !important;
    font-weight: 900 !important;
    color: #FFFFFF !important;
  }

  .cta-subtitle {
    font-size: 0.75rem !important;
    font-weight: 700 !important;
    color: rgba(255, 255, 255, 0.9) !important;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .smilu-trustpilot-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
  }

  .tp-stars {
    display: flex;
    gap: 2px;
  }

  .tp-stars svg {
    width: 20px;
    height: 20px;
  }

  .tp-text {
    font-size: 0.8rem;
    font-weight: 500;
    color: #475569 !important;
  }

  .tp-text strong {
    color: #00B67A !important;
  }

  .smilu-bb-compare {
    font-size: 0.6em;
    font-weight: 500;
    color: #94A3B8 !important;
    margin-left: 8px;
  }

  .smilu-dual-cta[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  #smilu-bb-form {
    margin: 0;
  }

  @media (max-width: 767px) {
    .smilu-buybox-wrapper {
      padding: 20px 16px;
    }
    .smilu-bb-title {
      font-size: 1.3rem !important;
    }
    .smilu-bb-promise {
      font-size: 0.875rem !important;
    }
    .smilu-bb-price {
      font-size: 2rem !important;
    }
    .smilu-dual-cta {
      padding: 16px 18px !important;
    }
    .tp-stars svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

{%- liquid
  assign bb_product = section.settings.buybox_product
  assign v = bb_product.selected_or_first_available_variant
-%}

<div class="smilu-buybox-wrapper">
  {%- if bb_product == blank -%}
    <p style="padding:16px;color:#B42318;font-weight:600;">
      Selecciona el producto del BuyBox en el editor de temas.
    </p>
  {%- else -%}

  {%- comment -%} Stock real: solo se muestra si Shopify rastrea inventario y quedan pocas {%- endcomment -%}
  {%- if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' and v.inventory_quantity > 0 and v.inventory_quantity <= 10 -%}
    <div class="smilu-bb-stock">
      <div class="pulse-dot"></div>
      <span>Solo quedan {{ v.inventory_quantity }} unidades</span>
    </div>
  {%- endif -%}

  <!-- Header -->
  <div class="smilu-buybox-header">
    {%- assign t_parts = bb_product.title | split: ' - ' -%}
    <h2 class="smilu-bb-title">{{ t_parts[0] }}</h2>
    {%- if t_parts.size > 1 -%}
      {%- assign t_promise = bb_product.title | remove_first: t_parts[0] | remove_first: ' - ' -%}
      <p class="smilu-bb-promise">{{ t_promise }}</p>
    {%- endif -%}
    <div class="smilu-bb-price">
      {{ v.price | money }}
      {%- if v.compare_at_price > v.price -%}
        <s class="smilu-bb-compare">{{ v.compare_at_price | money }}</s>
      {%- endif -%}
    </div>
  </div>

  <!-- Pago -->
  <div class="smilu-mp-banner">
    <div class="smilu-mp-text">
      {{ section.settings.payment_line | default: 'Pago contra entrega en Caracas' }}
      <span>{{ section.settings.payment_line_alt | default: 'Resto del pais: pago movil por adelantado' }}</span>
    </div>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00C2FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="1" y="4" width="22" height="16" rx="2"></rect>
      <line x1="1" y1="10" x2="23" y2="10"></line>
    </svg>
  </div>

  <!-- Envio -->
  <div class="smilu-shipping-banner">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00C97B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="1" y="3" width="15" height="13"></rect>
      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
      <circle cx="5.5" cy="18.5" r="2.5"></circle>
      <circle cx="18.5" cy="18.5" r="2.5"></circle>
    </svg>
    <span>{{ section.settings.shipping_line | default: 'Entrega en Caracas en 24-48h' }}</span>
  </div>

  <!-- CTA real: agrega al carrito -->
  {%- form 'product', bb_product, id: 'smilu-bb-form', novalidate: 'novalidate' -%}
    <input type="hidden" name="id" value="{{ v.id }}">
    <input type="hidden" name="quantity" value="1">
    <button type="submit" class="smilu-dual-cta" {% unless v.available %}disabled{% endunless %}>
      {%- if v.available -%}
        <span class="cta-title">{{ section.settings.cta_title | default: 'Recuperar mi Salud Dental' }}</span>
        <span class="cta-subtitle">{{ section.settings.cta_subtitle | default: 'Envio incluido - Garantia de 30 dias' }}</span>
      {%- else -%}
        <span class="cta-title">Agotado</span>
        <span class="cta-subtitle">Vuelve pronto</span>
      {%- endif -%}
    </button>
  {%- endform -%}

  {%- endif -%}

  <!-- Trustpilot Integration -->
  <div class="smilu-trustpilot-box">
    <div class="tp-stars">
      <!-- 5 Green Stars -->
      {% for i in (1..5) %}
        <svg viewBox="0 0 24 24" fill="#00B67A" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
        </svg>
      {% endfor %}
    </div>
    <div class="tp-text">Excelente <strong>4.9/5</strong> en Trustpilot</div>
    <div class="tp-text" style="font-size: 0.7rem;">Basado en +12,000 usuarios</div>
  </div>
</div>
