{% assign product = target_product | default: product %}

<style>
  :root {
    --smilu-accent: #00C97B;
    --smilu-bg-dark: #0A0A0C;
    --smilu-bg-light: #F8FAFC;
    --smilu-text-dark: #030303;
    --smilu-text-light: #FFFFFF;
    --smilu-font-head: 'Fredoka', sans-serif;
    --smilu-font-body: 'Nunito', sans-serif;
  }

  .smilu-salespage-wrapper {
    font-family: var(--smilu-font-body) !important;
    max-width: 100vw;
    overflow-x: hidden;
  }

  .smilu-salespage-wrapper h1,
  .smilu-salespage-wrapper h2,
  .smilu-salespage-wrapper h3,
  .smilu-salespage-wrapper h4 {
    font-family: var(--smilu-font-head) !important;
    font-weight: 800 !important;
    line-height: 1.08 !important;
    letter-spacing: -0.04em !important;
  }

  /* Módulo 1: Hero PDP */
  .smilu-hero {
    display: flex;
    flex-wrap: wrap;
    background: var(--smilu-bg-light);
    padding: 60px 20px;
    gap: 40px;
    justify-content: center;
  }

  .smilu-hero-left, .smilu-hero-right {
    flex: 1 1 500px;
    max-width: 600px;
  }

  .smilu-hero-left img {
    width: 100%;
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  }

  .smilu-buy-box {
    background: var(--smilu-text-light);
    padding: 40px;
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .smilu-trustpilot {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-weight: 700;
    color: #00B67A !important;
  }

  .smilu-buy-box h1 {
    font-size: 2.5rem;
    color: var(--smilu-text-dark) !important;
    margin-bottom: 16px;
  }

  .smilu-price-block {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 24px;
  }

  .smilu-price {
    font-size: 2rem;
    font-weight: 900;
    color: var(--smilu-text-dark) !important;
  }

  .smilu-compare-price {
    font-size: 1.2rem;
    text-decoration: line-through;
    color: #94A3B8 !important;
  }

  /* MercadoPago Banner */
  .smilu-mp-banner {
    background: #009EE3;
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .smilu-mp-banner span {
    color: #FFFFFF !important;
    font-weight: 700 !important;
    font-size: 0.9rem;
  }

  /* Dual Text CTA */
  .smilu-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--smilu-accent) !important;
    color: var(--smilu-text-light) !important;
    border: none;
    border-radius: 16px;
    padding: 20px;
    width: 100%;
    cursor: pointer;
    text-decoration: none;
    margin-bottom: 16px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .smilu-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 201, 123, 0.3);
  }

  .smilu-cta-main {
    font-family: var(--smilu-font-head) !important;
    font-size: 1.4rem;
    font-weight: 800;
    color: #FFFFFF !important;
  }

  .smilu-cta-sub {
    font-size: 0.85rem;
    font-weight: 700;
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #FFFFFF !important;
  }

  /* Stock Vivo */
  .smilu-stock-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
    font-weight: 700;
    color: var(--smilu-text-dark) !important;
  }

  .smilu-pulse-dot {
    width: 10px;
    height: 10px;
    background-color: #EF4444;
    border-radius: 50%;
    animation: smilu-pulse 1.5s infinite;
  }

  @keyframes smilu-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
  }

  /* Secciones Oscuras (Anti-Invisibilidad) */
  .smilu-dark-section {
    background: var(--smilu-bg-dark);
    padding: 100px 20px;
    text-align: center;
  }

  .smilu-dark-section h2,
  .smilu-dark-section p,
  .smilu-dark-section span {
    color: var(--smilu-text-light) !important;
  }
  
  .smilu-dark-section h2 {
    font-size: 3rem;
    margin-bottom: 24px;
  }

  .smilu-dark-section p {
    font-size: 1.2rem;
    max-width: 800px;
    margin: 0 auto;
    opacity: 0.9;
    line-height: 1.6;
  }

  /* Badges */
  .smilu-trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin-top: 24px;
  }

  .smilu-trust-badges span {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: #64748B !important;
    font-weight: 600;
  }

  .smilu-trust-badges svg {
    width: 18px;
    height: 18px;
    stroke: var(--smilu-accent);
  }

  /* Responsive Ahorro de Scroll */
  @media (max-width: 768px) {
    .smilu-hero {
      padding: 40px 16px 20px 16px;
    }
    .smilu-buy-box {
      padding: 24px 16px;
    }
    .smilu-dark-section {
      padding: 60px 16px;
    }
    .smilu-dark-section h2 {
      font-size: 2rem;
    }
  }
</style>

<div class="smilu-salespage-wrapper">
  
  <!-- Módulo 1: Hero & Buy Box Hiper-Densa -->
  <section class="smilu-hero">
    <div class="smilu-hero-left">
      <!-- Placeholder image for Product -->
      <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-product-5_large.png?format=webp" alt="Smilu Sónico" fetchpriority="high">
    </div>
    
    <div class="smilu-hero-right">
      <div class="smilu-buy-box">
        
        <div class="smilu-trustpilot">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#00B67A"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Excelente 4.9/5 basado en +15,000 ventas en Chile
        </div>

        <h1>El Cepillo Sónico que la Industria Desechable no Quiere que Descubras.</h1>
        
        <div class="smilu-price-block">
          {% assign form_product = target_product | default: product %}
          <span class="smilu-price">{{ form_product.price | default: 49990 | money }}</span>
          <span class="smilu-compare-price">{{ form_product.compare_at_price | default: 79990 | money }}</span>
        </div>

        <div class="smilu-mp-banner">
          <span>💳 Pago 100% Seguro con MercadoPago</span>
          <span>Hasta 6 cuotas sin interés</span>
        </div>

        <!-- Formulario Opcional para Add to Cart real de Shopify -->
        {% if form_product != blank %}
          {% form 'product', form_product %}
            <input type="hidden" name="id" value="{{ form_product.selected_or_first_available_variant.id }}">
            <button type="submit" class="smilu-cta">
              <span class="smilu-cta-main">Reclamar mi Smilu Sónico 🚀</span>
              <span class="smilu-cta-sub">ANTES DE QUE SE AGOTE LA PROMO 🔥</span>
            </button>
          {% endform %}
        {% else %}
          <button type="button" class="smilu-cta" onclick="alert('Selecciona un producto en el menú lateral del editor de Shopify.')">
            <span class="smilu-cta-main">Reclamar mi Smilu Sónico 🚀</span>
            <span class="smilu-cta-sub">SELECCIONA EL PRODUCTO EN EL EDITOR 🔥</span>
          </button>
        {% endif %}

        <div class="smilu-stock-indicator">
          <div class="smilu-pulse-dot"></div>
          <span>Solo quedan {{ 'now' | date: '%S' | modulo: 5 | plus: 3 }} unidades en oferta</span>
        </div>

        <div class="smilu-trust-badges">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            100% Seguro
          </span>
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            Pago Encriptado
          </span>
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            Envío Inmediato
          </span>
        </div>

      </div>
    </div>
  </section>

  <!-- Módulo 2: Exposición del Enemigo Común -->
  <section class="smilu-dark-section">
    <h2>Pagar $150 dólares por un cepillo que vibra como tractor y muere en 4 meses es una estafa.</h2>
    <p>Las grandes corporaciones te han mentido. Diseñan "cepillos inteligentes" con baterías soldadas que fallan por corrosión interna justo cuando vence la garantía. Te obligan a estar atado a su ecosistema de recambios costosos, convirtiendo tu salud dental en una suscripción mensual oculta. Ya basta.</p>
  </section>

  <!-- Módulo 3: Solución 1 - Dignidad/Biomecánico -->
  <section class="smilu-hero" style="background: #FFFFFF;">
    <div class="smilu-hero-right" style="display: flex; flex-direction: column; justify-content: center;">
      <h2 style="font-size: 2.5rem; color: var(--smilu-text-dark) !important; margin-bottom: 20px;">Sientes que te arrancas la piel de la encía (y de la lengua).</h2>
      <p style="font-size: 1.1rem; color: #475569 !important; line-height: 1.6; margin-bottom: 24px;">Cepillos duros de supermercado y raspadores de metal de ferretería. El sangrado y el dolor no son "normales". Smilu utiliza cerdas micro-pulidas y vibración sónica calibrada para acariciar el tejido gingival mientras pulveriza la placa bacteriana a 40,000 vibraciones por minuto.</p>
    </div>
    <div class="smilu-hero-left">
      <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png?format=webp" alt="Biomecánico" loading="lazy">
    </div>
  </section>

  <!-- Módulo 4: Solución 2 - Médico/Supervivencia -->
  <section class="smilu-dark-section" style="background: #0F172A;">
    <h2>El Escudo Social Definitivo Contra el Mal Aliento.</h2>
    <p>Hablar cerca, reír a carcajadas, despertar junto a tu pareja. El miedo a tener mal aliento paraliza. Nuestro ecosistema (Cepillo Sónico + Limpiador Lingual especializado) no solo enmascara el olor con menta; destruye los nidos bacterianos en las cavidades microscópicas de la lengua y los espacios interdentales. Te devolvemos la confianza de tener una boca de cristal.</p>
  </section>

  <!-- Módulo 7: Stack de Oferta Irresistible -->
  <section class="smilu-hero" style="background: var(--smilu-bg-light); text-align: center;">
    <div style="max-width: 800px; margin: 0 auto; width: 100%;">
      <h2 style="font-size: 2.5rem; color: var(--smilu-text-dark) !important; margin-bottom: 40px;">No estás comprando un cepillo. Estás invirtiendo en el "Grand Slam Dental Stack".</h2>
      
      <div style="background: #FFF; padding: 40px; border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: left;">
        <ul style="list-style: none; padding: 0; margin: 0;">
          <li style="display: flex; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid #E2E8F0;">
            <strong style="color: var(--smilu-text-dark) !important; font-size: 1.1rem;">✅ 1x Motor Sónico Smilu Élite</strong>
            <span style="color: #94A3B8 !important; text-decoration: line-through;">Valor: $80.000</span>
          </li>
          <li style="display: flex; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid #E2E8F0;">
            <strong style="color: var(--smilu-text-dark) !important; font-size: 1.1rem;">✅ 4x Cabezales de Cerdas Suaves de Grado Clínico</strong>
            <span style="color: #94A3B8 !important; text-decoration: line-through;">Valor: $25.000</span>
          </li>
          <li style="display: flex; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid #E2E8F0;">
            <strong style="color: var(--smilu-text-dark) !important; font-size: 1.1rem;">🎁 BONUS: 1x Limpiador Lingual Ergonómico Anti-Arcadas</strong>
            <span style="color: #94A3B8 !important; text-decoration: line-through;">Valor: $15.000</span>
          </li>
          <li style="display: flex; justify-content: space-between; padding: 16px 0;">
            <strong style="color: var(--smilu-text-dark) !important; font-size: 1.1rem;">🛡️ Garantía Absoluta contra Fallas de Fábrica</strong>
            <span style="color: #94A3B8 !important; text-decoration: line-through;">Invaluable</span>
          </li>
        </ul>
        
        <div style="margin-top: 32px; padding-top: 24px; border-top: 2px dashed #CBD5E1; text-align: center;">
          <div style="font-size: 1.2rem; color: #475569 !important; margin-bottom: 8px;">Valor Total de la Industria: <span style="text-decoration: line-through; color: #EF4444 !important;">$120.000</span></div>
          <div style="font-size: 2.5rem; font-weight: 900; color: var(--smilu-text-dark) !important; margin-bottom: 24px;">Hoy por solo: {{ product.price | default: 49990 | money }}</div>
          
          {% form 'product', product %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="smilu-cta">
              <span class="smilu-cta-main">Llevarme todo el Pack Ahora 🚀</span>
              <span class="smilu-cta-sub">ENVÍO INMEDIATO A TODO CHILE</span>
            </button>
          {% endform %}
        </div>
      </div>
    </div>
  </section>

</div>
