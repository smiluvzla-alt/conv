    <div class="container">
      <div class="container__top-part">
        {% section 'top-info-bar' %}
        
        <div id="booster__popup--holder" class="booster__popup--holder">
        </div>

        {% if template.suffix == 'no-header' or template.suffix == 'landing-no-header' %}
        {% elsif template.suffix == 'landing-alt-header' %}
          {% section 'header-alt' %}
        {% else %}
          {% case settings.headerType %}
            {% when 'default' %}
              {% section 'header--default' %}
            {% when 'inline-search' %}
              {% section 'header--inline-search' %}
            {% when 'logo-top' %}
              {% section 'header--logo-top' %}
          {% endcase %}
        {% endif %}

        {% section 'bottom-info-bar' %}
      </div> 

      <div id="quickbuy__modal" class="modal"><div onclick="closeModal(event)" class="overlay"></div><div class="content"></div></div>

      {% if settings.recentlyBought %}
        <a id="recently-bought--holder" class="recently-bought--holder {% unless settings.recentlyBoughtMobile -%}hide-mobile{%-endunless-%}">
          <div class="recently-bought--img-ratio"><div class="recently-bought--img"><img src=""></div></div>
          <div class="recently-bought--info">
            <div class="recently-bought--who"></div>
            <div class="recently-bought--what"></div>
            <div class="recently-bought--price"><span class="current-price"></span><span class="old-price"></span></div>
            <div class="recently-bought--when"></div>
          </div>
        </a>
        <script>
          const recentlyBoughtConfig = { useNames: {{settings.recentlyBoughtNames}}, nameFormat: '{{settings.recentlyBoughtNameFormat}}', allProductsUrl: '{{routes.all_products_collection_url}}' }
        </script>
      {% endif %}

      <div class="add-to-cart__success--holder modal">
        {% unless settings.cartAction == 'message' %}<div onclick="closeModal(event)" class="overlay add-to-cart__success--overlay"></div>{% endunless %}
        <div class="add-to-cart__success" id="checkout--success">
        {% render 'add-to-cart__template--success' %}
        </div>
      </div>

      {% render 'layout__template--specific' %}

      <main role="main">
        {{ content_for_layout }}

        <div class="wrapper--bottom">
          {% section 'info-badges' %}
          {% section 'footer' %}
          {% section 'subfooter' %}
        </div>
      </main>
    </div>

    {% render 'layout__app--code' %}
    {% render 'layout__bstr--constants' %}

    {{ '/services/javascripts/currencies.js' | script_tag }}
    {% comment %} If you want to serve the non-minified version, remove .min extension {% endcomment %}
    {{ 'booster.min.js' | asset_url | script_tag }}
    {{ 'unicons.css' | asset_url | stylesheet_tag }}
 
    {% unless settings.bodyHTML == blank %}
      {{settings.bodyHTML}}
    {% endunless %}
    {% unless settings.bodyCSS == blank %}
      <style>
        {{settings.bodyCSS}}
      </style>
    {% endunless %}
    {% unless settings.bodyJS == blank %}
      <script>
        {{settings.bodyJS}}
      </script>
    {% endunless %}

    {% if settings.reviewApp == "alireviews" or settings.jQuery %}
      <script
        src="https://code.jquery.com/jquery-3.5.1.min.js"
        integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
        crossorigin="anonymous" defer="defer">
      </script>
    {% endif %}
    {% if template contains 'product' and settings.jQuery %}
    <script src="{{ 'jquery.zoom.min.js' | asset_url }}" type="text/javascript" defer="defer"></script>
    {% endif %}

    {% render 'layout__custom-code--body' %}
    
    {% if settings.backTopBtn %}
      {% render 'scroll_top_button' %}
    {% endif %}

    <!-- Sticky Buy Bar -->
    <style>
      .smilu-sticky-bar {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%) translateY(150px);
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(10, 37, 64, 0.1);
        border-radius: 999px;
        padding: 12px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        box-shadow: 0 10px 40px rgba(10, 37, 64, 0.15);
        z-index: 9999;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
        opacity: 0;
        width: 90%;
        max-width: 800px;
        pointer-events: none;
      }
      .smilu-sticky-bar.is-visible {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
        pointer-events: auto;
      }
      .smilu-sticky-text {
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        color: #0A2540;
      }
      .smilu-sticky-highlight {
        color: #C89B3C;
      }
      .smilu-sticky-btn {
        background: #0A2540;
        color: #FFFFFF;
        padding: 10px 24px;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
        font-size: 0.9rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        white-space: nowrap;
      }
      .smilu-sticky-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(10, 37, 64, 0.3);
      }
      @media (max-width: 600px) {
        .smilu-sticky-bar {
          bottom: 16px;
          padding: 8px 12px;
          gap: 12px;
        }
        .smilu-sticky-text {
          font-size: 0.75rem;
          line-height: 1.2;
        }
        .smilu-sticky-btn {
          padding: 8px 16px;
          font-size: 0.8rem;
        }
      }
    </style>

    <div class="smilu-sticky-bar" id="smiluStickyBar">
      <div class="smilu-sticky-text">
        <span class="smilu-sticky-highlight">Ahorra 30%</span> + Envío Inmediato | 🛡️ Garantía 90 Días
      </div>
      <a href="#pitch" class="smilu-sticky-btn">Ver Oferta</a>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const stickyBar = document.getElementById('smiluStickyBar');
        window.addEventListener('scroll', () => {
          if (window.scrollY > 500) {
            stickyBar.classList.add('is-visible');
          } else {
            stickyBar.classList.remove('is-visible');
          }
        });
      });
    </script>

