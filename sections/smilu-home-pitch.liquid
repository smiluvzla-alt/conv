{% schema %}
{
  "name": "Smilu Home - El Pitch",
  "tag": "section",
  "class": "smilu-home-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular de Sección",
      "default": "El Arsenal Definitivo."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección Bestsellers"
    }
  ],
  "presets": [
    {
      "name": "Smilu Home - El Pitch"
    }
  ]
}
{% endschema %}

<style>
  .smilu-pitch-wrapper {
    background-color: var(--smilu-bg-cream, #FAF9F6);
    padding: 100px 20px;
    font-family: var(--font-sans, sans-serif);
  }
  .smilu-pitch-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .smilu-pitch-heading {
    text-align: center;
    font-family: var(--font-serif, serif) !important;
    font-weight: 700 !important;
    font-size: clamp(2.5rem, 4vw, 3.5rem) !important;
    color: var(--smilu-blue, #0A2540) !important;
    margin-bottom: 60px;
    letter-spacing: -0.02em !important;
  }
  .smilu-pitch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  .smilu-pitch-card {
    background: var(--smilu-gray-light, #F8FAFC);
    border: 1px solid rgba(0,0,0,0.03);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease, opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    opacity: 0;
    transform: translateY(40px);
  }
  .smilu-pitch-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .smilu-pitch-card:hover {
    transform: translateY(-8px);
    border-color: rgba(0,0,0,0.05);
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }
  .smilu-pitch-img-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #E2E8F0;
    position: relative;
    overflow: hidden;
  }
  .smilu-pitch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .smilu-pitch-card:hover .smilu-pitch-img {
    transform: scale(1.05);
  }
  .smilu-pitch-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .smilu-pitch-title {
    font-family: var(--font-serif, serif) !important;
    font-weight: 700 !important;
    font-size: 1.5rem !important;
    color: var(--smilu-blue, #0A2540) !important;
    margin-bottom: 8px;
    text-decoration: none;
  }
  .smilu-pitch-price {
    font-weight: 700 !important;
    font-size: 1.2rem !important;
    color: var(--smilu-cyan, #00D4FF) !important;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
  }
  .smilu-pitch-price strike {
    color: #94A3B8 !important;
    font-size: 0.95rem !important;
    margin-left: 10px;
  }
  
  /* Offer Stacking CSS */
  .smilu-offer-stack {
    margin-bottom: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(10, 37, 64, 0.1);
  }
  .smilu-offer-stack-title {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--smilu-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }
  .smilu-offer-stack-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .smilu-offer-stack-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: #475569;
    margin-bottom: 8px;
  }
  .smilu-offer-stack-item span:last-child {
    font-weight: 600;
  }
  .smilu-offer-stack-item strike {
    color: #94A3B8;
    margin-right: 6px;
    font-weight: 400;
  }
  .smilu-offer-free {
    color: var(--smilu-cyan, #00D4FF);
  }
  .smilu-pitch-form {
    margin-top: auto;
  }
  .smilu-pitch-btn {
    width: 100%;
    background: var(--smilu-blue, #0A2540) !important;
    color: #FFFFFF !important;
    font-weight: 600 !important;
    font-size: 1.1rem !important;
    padding: 16px;
    border-radius: 999px; /* Pill Shape */
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-align: center;
    box-shadow: 0 4px 6px rgba(10, 37, 64, 0.1);
  }
  .smilu-pitch-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(10, 37, 64, 0.25);
  }
  .smilu-guarantee-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    background: rgba(10, 37, 64, 0.05);
    color: var(--smilu-blue);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-top: 16px;
    width: 100%;
  }

  /* Placeholder Styling */
  .smilu-placeholder-item {
    background: #E2E8F0; display: flex; align-items: center; justify-content: center; height: 100%; color: #94A3B8; font-size: 3rem;
  }
</style>

<div class="smilu-pitch-wrapper" id="pitch">
  <div class="smilu-pitch-container">
    <h2 class="smilu-pitch-heading">{{ section.settings.heading }}</h2>
    
    <div class="smilu-pitch-grid">
      {% if section.settings.collection != blank %}
        {% for product in collections[section.settings.collection].products limit: 3 %}
          <div class="smilu-pitch-card">
            <a href="{{ product.url }}" class="smilu-pitch-img-wrapper">
              <img src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title }}" class="smilu-pitch-img" loading="lazy">
            </a>
            <div class="smilu-pitch-content">
              <a href="{{ product.url }}" class="smilu-pitch-title">{{ product.title }}</a>
              <div class="smilu-pitch-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <strike>{{ product.compare_at_price | money }}</strike>
                {% endif %}
              </div>
              
              <!-- Offer Stack -->
              <div class="smilu-offer-stack">
                <div class="smilu-offer-stack-title">TU PEDIDO INCLUYE:</div>
                <ul class="smilu-offer-stack-list">
                  <li class="smilu-offer-stack-item">
                    <span>{{ product.title }}</span>
                    <span>Incluido</span>
                  </li>
                  <li class="smilu-offer-stack-item">
                    <span>Envío Inmediato</span>
                    <span><strike>$10.00</strike> <span class="smilu-offer-free">GRATIS</span></span>
                  </li>
                  <li class="smilu-offer-stack-item">
                    <span>Acceso a Comunidad VIP</span>
                    <span><strike>$25.00</strike> <span class="smilu-offer-free">GRATIS</span></span>
                  </li>
                </ul>
              </div>
              
              <div class="smilu-pitch-form">
                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                  <button type="submit" class="smilu-pitch-btn">Añadir al Carrito</button>
                {% endform %}
                <div class="smilu-guarantee-pill">
                  🛡️ Garantía de 90 Días
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Placeholder Cards -->
        {% for i in (1..3) %}
          <div class="smilu-pitch-card">
            <div class="smilu-pitch-img-wrapper">
              <div class="smilu-placeholder-item">Smilu</div>
            </div>
            <div class="smilu-pitch-content">
              <span class="smilu-pitch-title">Producto de Ejemplo</span>
              <div class="smilu-pitch-price">$49.99</div>
              <button class="smilu-pitch-btn" disabled>Selecciona Colección</button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Staggered Reveal for Pitch Cards
    const cards = document.querySelectorAll('.smilu-pitch-card');
    const observer = new IntersectionObserver((entries) => {
      let delay = 0;
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('is-visible');
          }, delay);
          delay += 100; // Stagger effect
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    
    cards.forEach(card => observer.observe(card));
  });
</script>
