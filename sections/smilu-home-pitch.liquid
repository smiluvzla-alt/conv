{% schema %}
{
  "name": "Smilu Home - El Pitch",
  "tag": "section",
  "class": "smilu-home-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular de Sección",
      "default": "El Arsenal Definitivo."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección Bestsellers"
    }
  ],
  "presets": [
    {
      "name": "Smilu Home - El Pitch"
    }
  ]
}
{% endschema %}

<style>
  .smilu-pitch-wrapper {
    background-color: #030303;
    padding: 100px 20px;
    font-family: var(--font-family, -apple-system, sans-serif);
  }
  .smilu-pitch-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .smilu-pitch-heading {
    text-align: center;
    font-weight: 900 !important;
    font-size: clamp(2rem, 4vw, 3rem) !important;
    color: #FFFFFF !important;
    margin-bottom: 60px;
    letter-spacing: -0.03em !important;
  }
  .smilu-pitch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  .smilu-pitch-card {
    background: #0A0A0A;
    border: 1px solid #1A1A1A;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
  }
  .smilu-pitch-card:hover {
    transform: translateY(-8px);
    border-color: #333333;
  }
  .smilu-pitch-img-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #111111;
    position: relative;
    overflow: hidden;
  }
  .smilu-pitch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .smilu-pitch-card:hover .smilu-pitch-img {
    transform: scale(1.05);
  }
  .smilu-pitch-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .smilu-pitch-title {
    font-weight: 800 !important;
    font-size: 1.3rem !important;
    color: #FFFFFF !important;
    margin-bottom: 8px;
    text-decoration: none;
  }
  .smilu-pitch-price {
    font-weight: 700 !important;
    font-size: 1.1rem !important;
    color: #00C97B !important;
    margin-bottom: 20px;
  }
  .smilu-pitch-price strike {
    color: #555555 !important;
    font-size: 0.9rem !important;
    margin-left: 8px;
  }
  .smilu-pitch-form {
    margin-top: auto;
  }
  .smilu-pitch-btn {
    width: 100%;
    background: #FFFFFF !important;
    color: #000000 !important;
    font-weight: 800 !important;
    font-size: 1.1rem !important;
    padding: 14px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease;
    text-align: center;
  }
  .smilu-pitch-btn:hover {
    background: #E2E8F0 !important;
  }

  /* Placeholder Styling */
  .smilu-placeholder-item {
    background: #111; display: flex; align-items: center; justify-content: center; height: 100%; color: #555; font-size: 3rem;
  }
</style>

<div class="smilu-pitch-wrapper" id="pitch">
  <div class="smilu-pitch-container">
    <h2 class="smilu-pitch-heading">{{ section.settings.heading }}</h2>
    
    <div class="smilu-pitch-grid">
      {% if section.settings.collection != blank %}
        {% for product in collections[section.settings.collection].products limit: 3 %}
          <div class="smilu-pitch-card">
            <a href="{{ product.url }}" class="smilu-pitch-img-wrapper">
              <img src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.title }}" class="smilu-pitch-img" loading="lazy">
            </a>
            <div class="smilu-pitch-content">
              <a href="{{ product.url }}" class="smilu-pitch-title">{{ product.title }}</a>
              <div class="smilu-pitch-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <strike>{{ product.compare_at_price | money }}</strike>
                {% endif %}
              </div>
              
              <div class="smilu-pitch-form">
                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                  <button type="submit" class="smilu-pitch-btn">Añadir al Carrito</button>
                {% endform %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Placeholder Cards -->
        {% for i in (1..3) %}
          <div class="smilu-pitch-card">
            <div class="smilu-pitch-img-wrapper">
              <div class="smilu-placeholder-item">Smilu</div>
            </div>
            <div class="smilu-pitch-content">
              <span class="smilu-pitch-title">Producto de Ejemplo</span>
              <div class="smilu-pitch-price">$49.99</div>
              <button class="smilu-pitch-btn" disabled>Selecciona Colección</button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>
