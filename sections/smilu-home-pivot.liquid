{% schema %}
{
  "name": "Smilu Home - Pivote",
  "tag": "section",
  "class": "smilu-home-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular de Sección",
      "default": "Diseñado para durar. No para desechar."
    }
  ],
  "presets": [
    {
      "name": "Smilu Home - Pivote"
    }
  ]
}
{% endschema %}

<style>
  .smilu-pivot-wrapper {
    background-color: var(--smilu-bg-light, #FFFFFF);
    padding: 100px 20px;
    font-family: var(--font-family, -apple-system, sans-serif);
  }
  .smilu-pivot-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .smilu-pivot-heading {
    text-align: center;
    font-weight: 900 !important;
    font-size: clamp(2rem, 4vw, 3rem) !important;
    color: var(--smilu-text-dark, #050505) !important;
    margin-bottom: 60px;
    letter-spacing: -0.03em !important;
    line-height: 1.1 !important;
  }
  .smilu-pivot-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .smilu-pivot-card {
    background: var(--smilu-gray-light, #F8FAFC);
    border: 1px solid rgba(0,0,0,0.03);
    border-radius: 16px;
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }
  .smilu-pivot-card:hover {
    transform: translateY(-5px);
    background: #FFFFFF;
    border-color: rgba(0,0,0,0.05);
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }
  .smilu-pivot-icon {
    width: 48px;
    height: 48px;
    background: rgba(0, 201, 123, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }
  .smilu-pivot-icon svg {
    width: 24px;
    height: 24px;
    stroke: var(--smilu-primary, #00D4FF);
    stroke-width: 1.5px;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .smilu-pivot-title {
    font-weight: 800 !important;
    font-size: 1.25rem !important;
    color: var(--smilu-text-dark, #050505) !important;
    margin-bottom: 12px;
  }
  .smilu-pivot-desc {
    font-weight: 400 !important;
    font-size: 1rem !important;
    color: #64748B !important;
    line-height: 1.5 !important;
  }

  @media (max-width: 900px) {
    .smilu-pivot-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .smilu-pivot-wrapper {
      padding: 60px 20px;
    }
  }
</style>

<div class="smilu-pivot-wrapper">
  <div class="smilu-pivot-container">
    <h2 class="smilu-pivot-heading">{{ section.settings.heading }}</h2>
    
    <div class="smilu-pivot-grid">
      <!-- Card 1 -->
      <div class="smilu-pivot-card">
        <div class="smilu-pivot-icon">
          <!-- Battery Shield Icon -->
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        </div>
        <h3 class="smilu-pivot-title">Cero Obsolescencia</h3>
        <p class="smilu-pivot-desc">Construido para durar años, no para morir a los 4 meses. Olvídate de comprar un cepillo nuevo cada vez que la batería se rinde.</p>
      </div>

      <!-- Card 2 -->
      <div class="smilu-pivot-card">
        <div class="smilu-pivot-icon">
          <!-- Shield Droplet Icon -->
          <svg viewBox="0 0 24 24"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
        </div>
        <h3 class="smilu-pivot-title">Protección Total</h3>
        <p class="smilu-pivot-desc">Sellado aeroespacial que previene la filtración de moho y bacterias internas (el secreto sucio de las grandes marcas).</p>
      </div>

      <!-- Card 3 -->
      <div class="smilu-pivot-card">
        <div class="smilu-pivot-icon">
          <!-- Sparkles Icon -->
          <svg viewBox="0 0 24 24"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
        </div>
        <h3 class="smilu-pivot-title">Dignidad y Estatus</h3>
        <p class="smilu-pivot-desc">Acabado boutique de precisión. Porque tu salud, tu confianza y tu baño no merecen plástico barato.</p>
      </div>
    </div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 3D Parallax Tilt Effect (Teenage Engineering Style)
    const cards = document.querySelectorAll('.smilu-pivot-card');
    cards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        const tiltX = (y - 0.5) * -12; // max 12deg
        const tiltY = (x - 0.5) * 12;
        card.style.transform = `perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale3d(1.02, 1.02, 1.02)`;
        card.style.transition = 'transform 0.1s ease, box-shadow 0.1s ease';
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        card.style.transition = 'transform 0.5s ease, box-shadow 0.5s ease';
      });
    });
  });
</script>  </div>
</div>
