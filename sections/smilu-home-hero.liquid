{% schema %}
{
  "name": "Smilu Home - El Gancho",
  "tag": "section",
  "class": "smilu-home-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen Hero (Fondo)"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titular (H1)",
      "default": "Destruye el mal aliento matutino."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subtítulo",
      "default": "Pagar cientos de dólares por un cepillo que se corrompe por dentro en 3 meses es un robo. Smilü nace para destruir esa mentira. Despierta listo para hablar de cerca."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del Botón"
    }
  ],
  "presets": [
    {
      "name": "Smilu Home - El Gancho"
    }
  ]
}
{% endschema %}

<style>
  :root {
    --smilu-bg-cream: #FAF9F6;
    --smilu-blue: #0A2540;
    --smilu-cyan: #00D4FF;
    --smilu-gold: #C89B3C;
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .smilu-hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(60px, 10vw, 100px) 20px;
    background: radial-gradient(circle at 50% 30%, #FFFFFF 0%, var(--smilu-bg-cream) 70%);
    overflow: hidden;
  }
  .smilu-hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.1;
    z-index: 1;
  }
  .smilu-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 4vw, 30px);
  }
  
  @keyframes smiluReveal {
    0% { opacity: 0; transform: translateY(40px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .smilu-hero-title {
    font-family: var(--font-serif) !important;
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--smilu-blue) !important;
    margin-bottom: clamp(16px, 3vw, 24px);
    animation: smiluReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  .smilu-hero-subtitle {
    font-family: var(--font-sans) !important;
    font-size: clamp(1rem, 2vw, 1.125rem);
    font-weight: 400;
    line-height: 1.6;
    color: #475569 !important;
    margin-bottom: clamp(24px, 5vw, 40px);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    animation: smiluReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    opacity: 0;
  }
  
  .smilu-hero-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--smilu-blue-vibrant, #005CFF) !important;
    color: #FFFFFF !important;
    padding: clamp(14px, 3vw, 18px) clamp(24px, 5vw, 40px);
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    box-shadow: 0 6px 20px rgba(0, 92, 255, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    border: none;
    cursor: pointer;
    width: 100%;
    max-width: 400px;
    min-height: 60px; /* Accesibility tap target */
    animation: smiluReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    opacity: 0;
  }
  .smilu-hero-cta:hover {
    transform: translateY(-3px);
    background: #004BCC !important;
    box-shadow: 0 10px 25px rgba(0, 92, 255, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.2);
  }
  .smilu-cta-main {
    font-weight: 900 !important;
    font-size: clamp(1.1rem, 2.5vw, 1.3rem) !important;
    color: #FFFFFF !important;
  }
  .smilu-cta-sub {
    font-weight: 700 !important;
    font-size: 0.75rem !important;
    letter-spacing: 0.05em !important;
    opacity: 0.8 !important;
    color: #FFFFFF !important;
    margin-top: 4px;
  }
  @media (max-width: 768px) {
    .smilu-hero-wrapper {
      min-height: 70vh;
    }
  }
</style>

<div class="smilu-hero-wrapper">
  {% if section.settings.hero_image != blank %}
    <img src="{{ section.settings.hero_image | image_url: width: 1440 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1440 }} 1440w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ section.settings.hero_image.alt | escape }}" class="smilu-hero-bg" fetchpriority="high" loading="eager" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}">
  {% else %}
    <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-lifestyle-1_large.png?format=webp" alt="Placeholder" class="smilu-hero-bg" fetchpriority="high" loading="eager" width="1440" height="960">
  {% endif %}

  <div class="smilu-hero-content">
    <div style="margin-bottom: clamp(10px, 3vw, 20px);">
      <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#050505" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="M12 8v4" stroke="#00D4FF"/>
        <path d="M9 14l3-3 3 3"/>
      </svg>
    </div>
    <h1 class="smilu-hero-title">{{ section.settings.headline }}</h1>
    <p class="smilu-hero-subtitle">{{ section.settings.subheadline }}</p>
    
    <a href="{{ section.settings.cta_link | default: '#pitch' }}" class="smilu-hero-cta">
      <span class="smilu-cta-main">¡Consigue tu Smilü! Ü</span>
      <span class="smilu-cta-sub">ANTES DE QUE SE AGOTEN LAS UNIDADES 🔥</span>
    </a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Magnetic Pull Button (Optional interaction, no longer blocks rendering)
    const btn = document.querySelector('.smilu-hero-cta');
    if (btn) {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const x = (e.clientX - rect.left - rect.width / 2) * 0.25;
        const y = (e.clientY - rect.top - rect.height / 2) * 0.25;
        btn.style.transform = `translate(${x}px, ${y}px) scale(1.02)`;
      });
      btn.addEventListener('mouseleave', () => {
        btn.style.transform = 'translate(0px, 0px) scale(1)';
      });
    }
  });
</script>
