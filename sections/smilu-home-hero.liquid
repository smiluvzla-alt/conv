{% schema %}
{
  "name": "Smilu Home - El Gancho",
  "tag": "section",
  "class": "smilu-home-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen Hero (Fondo)"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titular (H1)",
      "default": "Destruye el mal aliento matutino."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subtítulo",
      "default": "Pagar cientos de dólares por un cepillo que se corrompe por dentro en 3 meses es un robo. Smilü nace para destruir esa mentira. Despierta listo para hablar de cerca."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del Botón"
    }
  ],
  "presets": [
    {
      "name": "Smilu Home - El Gancho"
    }
  ]
}
{% endschema %}

<style>
  :root {
    --smilu-bg-cream: #FAF9F6;
    --smilu-blue: #0A2540;
    --smilu-blue-vibrant: #005CFF;
    --smilu-trust: #00B67A;
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .smilu-hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(80px, 12vw, 140px) 20px;
    background: radial-gradient(circle at top right, rgba(0, 92, 255, 0.05) 0%, var(--smilu-bg-cream) 70%);
    overflow: hidden;
  }
  
  .smilu-hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.15;
    z-index: 1;
    filter: blur(2px) contrast(1.1);
  }

  .smilu-glow-orb {
    position: absolute;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(0,92,255,0.15) 0%, rgba(250,249,246,0) 70%);
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    border-radius: 50%;
    pointer-events: none;
    animation: smiluOrbFloat 10s ease-in-out infinite alternate;
  }
  @keyframes smiluOrbFloat {
    0% { transform: translate(-50%, 0) scale(1); }
    100% { transform: translate(-50%, 20px) scale(1.05); }
  }

  .smilu-glass-card {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 4vw, 40px);
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 32px;
    padding: clamp(40px, 6vw, 80px) clamp(20px, 5vw, 60px);
    box-shadow: 0 20px 60px rgba(10, 37, 64, 0.08), inset 0 1px 0 rgba(255, 255, 255, 1);
    transform-style: preserve-3d;
    animation: smiluCardIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    transform: translateY(40px);
  }

  @keyframes smiluCardIn {
    0% { opacity: 0; transform: translateY(40px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .smilu-hero-title {
    font-family: var(--font-serif) !important;
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--smilu-blue) !important;
    margin: 0;
    transform: translateZ(30px);
  }

  .smilu-hero-title span {
    color: var(--smilu-blue-vibrant);
  }
  
  .smilu-hero-subtitle {
    font-family: var(--font-sans) !important;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 500;
    line-height: 1.6;
    color: #475569 !important;
    max-width: 680px;
    margin: 0 auto;
    transform: translateZ(20px);
  }
  
  .smilu-hero-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--smilu-blue-vibrant, #005CFF) !important;
    color: #FFFFFF !important;
    padding: clamp(16px, 3vw, 20px) clamp(32px, 5vw, 48px);
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 8px 24px rgba(0, 92, 255, 0.4), inset 0 2px 2px rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(0, 92, 255, 0.8);
    cursor: pointer;
    width: 100%;
    max-width: 420px;
    min-height: 64px;
    transform: translateZ(40px);
  }
  
  .smilu-hero-cta:hover {
    transform: translateY(-4px) translateZ(40px);
    background: #004BCC !important;
    box-shadow: 0 12px 32px rgba(0, 92, 255, 0.6), inset 0 2px 2px rgba(255, 255, 255, 0.3);
  }

  .smilu-cta-main {
    font-weight: 900 !important;
    font-size: clamp(1.2rem, 2.5vw, 1.4rem) !important;
    color: #FFFFFF !important;
    letter-spacing: -0.01em;
  }
  
  .smilu-cta-sub {
    font-weight: 700 !important;
    font-size: 0.75rem !important;
    letter-spacing: 0.08em !important;
    opacity: 0.85 !important;
    color: #FFFFFF !important;
    margin-top: 4px;
    text-transform: uppercase;
  }

  .smilu-trust-cluster {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: -12px;
    transform: translateZ(20px);
  }

  .smilu-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--smilu-blue);
  }

  .smilu-trust-stars {
    display: flex;
    gap: 2px;
  }
  
  .smilu-trust-stars svg {
    width: 16px;
    height: 16px;
    fill: var(--smilu-trust);
  }

  .smilu-icon-lucide {
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke: var(--smilu-blue);
  }

  @media (max-width: 768px) {
    .smilu-glass-card {
      padding: 40px 20px;
      border-radius: 24px;
      gap: 24px;
    }
    .smilu-trust-cluster {
      flex-direction: column;
      gap: 12px;
      margin-top: 0;
    }
  }
</style>

<div class="smilu-hero-wrapper">
  <div class="smilu-glow-orb"></div>
  {% if section.settings.hero_image != blank %}
    <img src="{{ section.settings.hero_image | image_url: width: 1440 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1440 }} 1440w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ section.settings.hero_image.alt | escape }}" class="smilu-hero-bg" fetchpriority="high" loading="eager" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}">
  {% else %}
    <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-lifestyle-1_large.png?format=webp" alt="Placeholder" class="smilu-hero-bg" fetchpriority="high" loading="eager" width="1440" height="960">
  {% endif %}

  <div class="smilu-glass-card goat-card-3d">
    <div style="margin-bottom: -10px; transform: translateZ(10px);">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" class="smilu-icon-lucide">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="M12 8v4" stroke="var(--smilu-blue-vibrant)"/>
        <path d="M9 14l3-3 3 3"/>
      </svg>
    </div>
    
    <h1 class="smilu-hero-title">Destruye el mal aliento <span>matutino.</span></h1>
    <p class="smilu-hero-subtitle">{{ section.settings.subheadline }}</p>
    
    <a href="{{ section.settings.cta_link | default: '#pitch' }}" class="smilu-hero-cta goat-btn-magnetic">
      <span class="smilu-cta-main">¡Consigue tu Smilü! Ü</span>
      <span class="smilu-cta-sub">ANTES DE QUE SE AGOTEN LAS UNIDADES 🔥</span>
    </a>

    <div class="smilu-trust-cluster">
      <div class="smilu-trust-item">
        <div class="smilu-trust-stars">
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <span>Excelente 4.9/5</span>
      </div>
      <div class="smilu-trust-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="smilu-icon-lucide" stroke="var(--smilu-trust)">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span>Garantía 90 Días</span>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 3D Parallax Tilt (Teenage Engineering/Apple effect)
    const cards = document.querySelectorAll('.goat-card-3d');
    cards.forEach(card => {
      // Solo activamos en desktop
      if (window.innerWidth > 768) {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = (e.clientY - rect.top) / rect.height;
          const tiltX = (y - 0.5) * -10; // max 10deg
          const tiltY = (x - 0.5) * 10;
          card.style.transform = `perspective(1200px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale3d(1.02, 1.02, 1.02) translateY(0)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1) translateY(0)';
        });
      }
    });

    // Magnetic Button Effect
    const magneticBtns = document.querySelectorAll('.goat-btn-magnetic');
    magneticBtns.forEach(btn => {
      if (window.innerWidth > 768) {
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const x = (e.clientX - rect.left - rect.width / 2) * 0.3;
          const y = (e.clientY - rect.top - rect.height / 2) * 0.3;
          btn.style.transform = `translate(${x}px, ${y}px) translateZ(40px) scale(1.05)`;
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = 'translate(0px, 0px) translateZ(40px) scale(1)';
        });
      }
    });
  });
</script>
