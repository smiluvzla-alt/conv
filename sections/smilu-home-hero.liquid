{% schema %}
{
  "name": "Smilu Home - El Gancho",
  "tag": "section",
  "class": "smilu-home-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen Hero (Fondo)"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titular (H1)",
      "default": "Siente la Boca de Cristal. Aniquila el Mal Aliento de Raíz."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subtítulo",
      "default": "Limpieza clínica de grado odontológico sin la obsolescencia programada de la industria desechable."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del Botón"
    }
  ],
  "presets": [
    {
      "name": "Smilu Home - El Gancho"
    }
  ]
}
{% endschema %}

<style>
  .smilu-hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    background-color: #000000;
    overflow: hidden;
  }
  .smilu-hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.5;
    z-index: 1;
  }
  .smilu-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }
  .smilu-hero-h1 {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-weight: 900 !important;
    font-size: clamp(2.5rem, 6vw, 4.5rem) !important;
    line-height: 1.05 !important;
    letter-spacing: -0.04em !important;
    color: #FFFFFF !important;
    margin: 0;
  }
  .smilu-hero-sub {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-weight: 500 !important;
    font-size: clamp(1.1rem, 2vw, 1.4rem) !important;
    line-height: 1.5 !important;
    color: #E2E8F0 !important;
    max-width: 600px;
  }
  .smilu-hero-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #00C97B !important;
    color: #FFFFFF !important;
    padding: 16px 40px;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 20px rgba(0, 201, 123, 0.4);
    border: none;
    cursor: pointer;
    width: 100%;
    max-width: 400px;
  }
  .smilu-hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 201, 123, 0.6);
  }
  .smilu-cta-main {
    font-weight: 800 !important;
    font-size: 1.3rem !important;
    color: #FFFFFF !important;
  }
  .smilu-cta-sub {
    font-weight: 700 !important;
    font-size: 0.75rem !important;
    letter-spacing: 0.05em !important;
    opacity: 0.9 !important;
    color: #FFFFFF !important;
    margin-top: 4px;
  }
  @media (max-width: 768px) {
    .smilu-hero-wrapper {
      min-height: 70vh;
      padding-top: 100px;
    }
  }
</style>

<div class="smilu-hero-wrapper">
  {% if section.settings.hero_image != blank %}
    <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Smilu Hero" class="smilu-hero-bg" fetchpriority="high">
  {% else %}
    <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-lifestyle-1_large.png?format=webp" alt="Placeholder" class="smilu-hero-bg" fetchpriority="high">
  {% endif %}

  <div class="smilu-hero-content">
    <h1 class="smilu-hero-h1">{{ section.settings.headline }}</h1>
    <p class="smilu-hero-sub">{{ section.settings.subheadline }}</p>
    
    <a href="{{ section.settings.cta_link | default: '#pitch' }}" class="smilu-hero-cta">
      <span class="smilu-cta-main">Recuperar mi Confianza 🚀</span>
      <span class="smilu-cta-sub">ANTES DE QUE SE AGOTEN LAS UNIDADES 🔥</span>
    </a>
  </div>
</div>
