{% schema %}
{
  "name": "Smilu Home - El Gancho",
  "tag": "section",
  "class": "smilu-home-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen Hero (Fondo)"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titular (H1)",
      "default": "Siente la boca de cristal."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subtítulo",
      "default": "Limpieza clínica inagotable que aniquila la paranoia del mal aliento matutino, construida con hardware que se niega a morir."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del Botón"
    }
  ],
  "presets": [
    {
      "name": "Smilu Home - El Gancho"
    }
  ]
}
{% endschema %}

<style>
  .smilu-hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100px 20px;
    background-color: var(--smilu-bg-light, #FFFFFF);
    overflow: hidden;
  }
  .smilu-hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.1;
    z-index: 1;
  }
  .smilu-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }
  .smilu-hero-h1 {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-weight: 900 !important;
    font-size: clamp(2.5rem, 6vw, 4.5rem) !important;
    line-height: 1.05 !important;
    letter-spacing: -0.04em !important;
    color: #050505 !important;
    margin: 0;
  }
  .smilu-hero-sub {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-weight: 500 !important;
    font-size: clamp(1.1rem, 2vw, 1.4rem) !important;
    line-height: 1.5 !important;
    color: #64748B !important;
    max-width: 600px;
  }
  .smilu-hero-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--smilu-primary, #00D4FF) !important;
    color: #0A0A0C !important;
    padding: 18px 40px;
    border-radius: 4px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 20px rgba(0, 212, 255, 0.4);
    border: none;
    cursor: pointer;
    width: 100%;
    max-width: 400px;
  }
  .smilu-hero-cta:hover {
    box-shadow: 0 8px 25px rgba(0, 212, 255, 0.6);
  }
  .smilu-cta-main {
    font-weight: 900 !important;
    font-size: 1.3rem !important;
    color: #0A0A0C !important;
  }
  .smilu-cta-sub {
    font-weight: 700 !important;
    font-size: 0.75rem !important;
    letter-spacing: 0.05em !important;
    opacity: 0.8 !important;
    color: #0A0A0C !important;
    margin-top: 4px;
  }
  @media (max-width: 768px) {
    .smilu-hero-wrapper {
      min-height: 70vh;
      padding-top: 100px;
    }
  }
</style>

<div class="smilu-hero-wrapper">
  {% if section.settings.hero_image != blank %}
    <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Smilu Hero" class="smilu-hero-bg" fetchpriority="high">
  {% else %}
    <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-lifestyle-1_large.png?format=webp" alt="Placeholder" class="smilu-hero-bg" fetchpriority="high">
  {% endif %}

  <div class="smilu-hero-content">
    <div style="margin-bottom: 20px;">
      <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#050505" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="M12 8v4" stroke="#00D4FF"/>
        <path d="M9 14l3-3 3 3"/>
      </svg>
    </div>
    <h1 class="smilu-hero-h1">{{ section.settings.headline }}</h1>
    <p class="smilu-hero-sub">{{ section.settings.subheadline }}</p>
    
    <a href="{{ section.settings.cta_link | default: '#pitch' }}" class="smilu-hero-cta">
      <span class="smilu-cta-main">Recuperar mi Confianza 🚀</span>
      <span class="smilu-cta-sub">ANTES DE QUE SE AGOTEN LAS UNIDADES 🔥</span>
    </a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Text Mask Reveal Effect (Awwwards Style)
    const h1 = document.querySelector('.smilu-hero-h1');
    if (h1) {
      h1.style.opacity = '0';
      h1.style.transform = 'translateY(40px)';
      h1.style.transition = 'opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1)';
      setTimeout(() => {
        h1.style.opacity = '1';
        h1.style.transform = 'translateY(0)';
      }, 100);
    }

    // 2. Magnetic Pull Button
    const btn = document.querySelector('.smilu-hero-cta');
    if (btn) {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const x = (e.clientX - rect.left - rect.width / 2) * 0.25;
        const y = (e.clientY - rect.top - rect.height / 2) * 0.25;
        btn.style.transform = `translate(${x}px, ${y}px) scale(1.02)`;
      });
      btn.addEventListener('mouseleave', () => {
        btn.style.transform = 'translate(0px, 0px) scale(1)';
      });
    }
  });
</script>
