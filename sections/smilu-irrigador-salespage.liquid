{% comment %}
  smilu-irrigador-salespage.liquid
  Salespage completa del Irrigador Smilu
  Ángulo: Dignidad/Estatus — "Tu baño no es un hospital. Tu aliento no tiene que delatarte."
  9 Módulos de Conversión (Protocolo $1M — Regla 32)
  
  COLORES SMILU (Regla 33 - Strict Token Shielding):
  --smilu-irr-cream: #FAF9F6
  --smilu-irr-navy: #0A2540
  --smilu-irr-blue: #005CFF (SOLO CTA)
  --smilu-irr-green: #00B67A (Trust/Micro)
  --smilu-irr-slate: #0F172A (contraste navy oscuro)
{% endcomment %}

<style>
  /* === SMILU IRRIGADOR TOKEN SYSTEM === */
  .smilu-irr-section {
    --smilu-irr-cream: #FAF9F6;
    --smilu-irr-navy: #0A2540;
    --smilu-irr-navy-light: #112B4A;
    --smilu-irr-slate: #0F172A;
    --smilu-irr-blue: #005CFF;
    --smilu-irr-green: #00B67A;
    --smilu-irr-green-dark: #009960;
    --smilu-irr-gold: #E8C547;
    --smilu-irr-font: -apple-system, BlinkMacSystemFont, "Inter", "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-family: var(--smilu-irr-font) !important;
  }

  /* === GLOBAL RESETS FOR SECTION === */
  .smilu-irr-section * {
    box-sizing: border-box;
  }

  .smilu-irr-section h1,
  .smilu-irr-section h2,
  .smilu-irr-section h3,
  .smilu-irr-section h4 {
    font-family: var(--smilu-irr-font) !important;
    font-weight: 900 !important;
    line-height: 1.06 !important;
    letter-spacing: -0.04em !important;
  }

  .smilu-irr-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* =============================================
     MÓDULO 1: HERO PDP HYPER-DENSE
     ============================================= */
  .smilu-irr-hero {
    background: var(--smilu-irr-cream);
    padding: 80px 0 60px;
    overflow: hidden;
    position: relative;
  }

  .smilu-irr-hero::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 50%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0,92,255,0.04) 0%, rgba(10,37,64,0.06) 100%);
    pointer-events: none;
  }

  .smilu-irr-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .smilu-irr-hero-img-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .smilu-irr-hero-img-wrap::before {
    content: '';
    position: absolute;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,92,255,0.10) 0%, transparent 70%);
    animation: smilu-irr-glow 4s ease-in-out infinite alternate;
  }

  @keyframes smilu-irr-glow {
    from { transform: scale(0.95); opacity: 0.6; }
    to   { transform: scale(1.05); opacity: 1; }
  }

  .smilu-irr-product-img {
    position: relative;
    z-index: 1;
    max-height: 540px;
    width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 24px 48px rgba(10,37,64,0.15));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .smilu-irr-product-img:hover {
    transform: translateY(-8px) scale(1.02);
  }

  .smilu-irr-hero-placeholder {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 3/4;
    background: linear-gradient(135deg, var(--smilu-irr-navy) 0%, var(--smilu-irr-navy-light) 100%);
    border-radius: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 40px 80px rgba(10,37,64,0.2);
  }

  .smilu-irr-hero-placeholder-icon {
    font-size: 80px;
  }

  /* Buy Box */
  .smilu-irr-buybox {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .smilu-irr-stars-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .smilu-irr-stars {
    display: flex;
    gap: 2px;
  }

  .smilu-irr-star-filled {
    color: #00B67A !important;
    font-size: 16px;
  }

  .smilu-irr-rating-text {
    font-family: var(--smilu-irr-font) !important;
    color: var(--smilu-irr-navy) !important;
    font-size: 13px;
    font-weight: 600;
  }

  .smilu-irr-badge-inline {
    display: inline-block;
    background: var(--smilu-irr-green);
    color: #FFFFFF !important;
    font-family: var(--smilu-irr-font) !important;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .smilu-irr-hero-title {
    font-size: clamp(2rem, 4vw, 3.2rem) !important;
    color: var(--smilu-irr-navy) !important;
    margin: 0;
  }

  .smilu-irr-hero-subtitle {
    font-family: var(--smilu-irr-font) !important;
    font-size: 17px;
    font-weight: 400;
    color: rgba(10,37,64,0.70) !important;
    line-height: 1.6;
    margin: 0;
  }

  .smilu-irr-price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .smilu-irr-price-current {
    font-family: var(--smilu-irr-font) !important;
    font-size: 2.4rem;
    font-weight: 900;
    color: var(--smilu-irr-navy) !important;
    letter-spacing: -0.03em;
  }

  .smilu-irr-price-original {
    font-family: var(--smilu-irr-font) !important;
    font-size: 1.1rem;
    font-weight: 400;
    color: rgba(10,37,64,0.4) !important;
    text-decoration: line-through;
  }

  .smilu-irr-price-save {
    font-family: var(--smilu-irr-font) !important;
    font-size: 12px;
    font-weight: 700;
    color: #FFFFFF !important;
    background: var(--smilu-irr-green);
    padding: 4px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Stock indicator */
  .smilu-irr-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: rgba(255,80,70,0.06);
    border: 1px solid rgba(255,80,70,0.20);
    border-radius: 10px;
  }

  .smilu-irr-stock-dot {
    width: 10px;
    height: 10px;
    background: #FF5046;
    border-radius: 50%;
    animation: smilu-irr-pulse 1.6s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes smilu-irr-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255,80,70,0.5); }
    50% { box-shadow: 0 0 0 6px rgba(255,80,70,0); }
  }

  .smilu-irr-stock-text {
    font-family: var(--smilu-irr-font) !important;
    font-size: 13px;
    font-weight: 700;
    color: #CC2A22 !important;
  }

  /* MercadoPago Banner */
  .smilu-irr-mp-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, #009EE3 0%, #0060A2 100%);
    border-radius: 14px;
    padding: 14px 18px;
  }

  .smilu-irr-mp-logo {
    font-family: var(--smilu-irr-font) !important;
    font-size: 18px;
    font-weight: 900;
    color: #FFFFFF !important;
    white-space: nowrap;
  }

  .smilu-irr-mp-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .smilu-irr-mp-cuotas {
    font-family: var(--smilu-irr-font) !important;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF !important;
  }

  .smilu-irr-mp-sin-interes {
    font-family: var(--smilu-irr-font) !important;
    font-size: 11px;
    font-weight: 600;
    color: rgba(255,255,255,0.85) !important;
    letter-spacing: 0.03em;
  }

  .smilu-irr-mp-badge {
    margin-left: auto;
    background: rgba(255,255,255,0.2);
    color: #FFFFFF !important;
    font-family: var(--smilu-irr-font) !important;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  /* CTA Button Dual Text */
  .smilu-irr-cta-btn {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 18px 24px !important;
    background: var(--smilu-irr-green) !important;
    border: none !important;
    border-radius: 16px !important;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 8px 32px rgba(0,182,122,0.35) !important;
    gap: 4px;
  }

  .smilu-irr-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(0,182,122,0.45) !important;
  }

  .smilu-irr-cta-main {
    font-family: var(--smilu-irr-font) !important;
    font-size: 17px;
    font-weight: 800;
    color: #FFFFFF !important;
    letter-spacing: -0.01em;
  }

  .smilu-irr-cta-sub {
    font-family: var(--smilu-irr-font) !important;
    font-size: 11px;
    font-weight: 600;
    color: rgba(255,255,255,0.75) !important;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Trustpilot row */
  .smilu-irr-trustpilot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px;
    background: rgba(10,37,64,0.04);
    border-radius: 12px;
  }

  .smilu-irr-tp-logo {
    font-family: var(--smilu-irr-font) !important;
    font-size: 14px;
    font-weight: 700;
    color: var(--smilu-irr-navy) !important;
  }

  .smilu-irr-tp-stars {
    display: flex;
    gap: 2px;
  }

  .smilu-irr-tp-star {
    width: 16px;
    height: 16px;
    background: var(--smilu-irr-green);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .smilu-irr-tp-star svg {
    width: 10px;
    height: 10px;
    fill: #FFFFFF;
  }

  .smilu-irr-tp-text {
    font-family: var(--smilu-irr-font) !important;
    font-size: 12px;
    font-weight: 600;
    color: rgba(10,37,64,0.65) !important;
  }

  /* Trust badges row */
  .smilu-irr-trust-badges {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }

  .smilu-irr-trust-badge {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .smilu-irr-trust-badge-icon {
    color: var(--smilu-irr-green) !important;
    font-size: 14px;
  }

  .smilu-irr-trust-badge-text {
    font-family: var(--smilu-irr-font) !important;
    font-size: 11px;
    font-weight: 600;
    color: rgba(10,37,64,0.65) !important;
  }

  /* =============================================
     MÓDULO 2: EXPOSICIÓN DEL ENEMIGO COMÚN
     ============================================= */
  .smilu-irr-enemy {
    background: url("{{ 'irr_enemy.webp' | asset_url }}") center center / cover no-repeat;
    position: relative;
    padding: 120px 0;
  }
  .smilu-irr-enemy::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(11, 32, 51, 0.85); /* Dark Navy overlay */
    z-index: 1;
  }
  .smilu-irr-enemy > .smilu-irr-container {
    position: relative;
    z-index: 2;
  }

  .smilu-irr-enemy-pretitle {
    font-family: var(--smilu-irr-font) !important;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--smilu-irr-green) !important;
    margin: 0 0 16px;
  }

  .smilu-irr-enemy-title {
    font-size: clamp(2rem, 4vw, 3.4rem) !important;
    color: #FFFFFF !important;
    margin: 0 0 20px;
    max-width: 700px;
  }

  .smilu-irr-enemy-lead {
    font-family: var(--smilu-irr-font) !important;
    font-size: 18px;
    color: rgba(255,255,255,0.72) !important;
    line-height: 1.65;
    max-width: 640px;
    margin: 0 0 60px;
  }

  .smilu-irr-enemy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .smilu-irr-enemy-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 20px;
    padding: 32px 28px;
    transition: border-color 0.3s;
  }

  .smilu-irr-enemy-card:hover {
    border-color: rgba(255,80,70,0.35);
  }

  .smilu-irr-enemy-icon {
    font-size: 36px;
    margin-bottom: 16px;
    display: block;
  }

  .smilu-irr-enemy-card-title {
    font-size: 1.15rem !important;
    color: #FFFFFF !important;
    margin: 0 0 10px;
    font-weight: 800 !important;
  }

  .smilu-irr-enemy-card-text {
    font-family: var(--smilu-irr-font) !important;
    font-size: 14px;
    color: rgba(255,255,255,0.62) !important;
    line-height: 1.6;
    margin: 0;
  }

  .smilu-irr-enemy-quote {
    font-family: var(--smilu-irr-font) !important;
    font-size: 13px;
    font-style: italic;
    color: rgba(255,255,255,0.40) !important;
    margin: 12px 0 0;
    padding: 10px 14px;
    border-left: 2px solid rgba(255,80,70,0.4);
  }

  /* =============================================
     MÓDULO 3/4/5/6: BLOQUES DE SOLUCIÓN
     ============================================= */
  .smilu-irr-solution {
    padding: 100px 0;
  }

  .smilu-irr-solution.cream { background: var(--smilu-irr-cream); }
  .smilu-irr-solution.white { background: #FFFFFF; }
  .smilu-irr-solution.slate { background: #F0F4F8; }
  .smilu-irr-solution.navy { background: var(--smilu-irr-navy); }

  .smilu-irr-sol-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .smilu-irr-sol-grid.reverse { direction: rtl; }
  .smilu-irr-sol-grid.reverse > * { direction: ltr; }

  .smilu-irr-sol-eyebrow {
    font-family: var(--smilu-irr-font) !important;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .smilu-irr-sol-eyebrow.green { color: var(--smilu-irr-green) !important; }
  .smilu-irr-sol-eyebrow.blue { color: var(--smilu-irr-blue) !important; }

  .smilu-irr-sol-title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem) !important;
    margin: 0 0 20px;
  }

  .smilu-irr-sol-title.dark { color: var(--smilu-irr-navy) !important; }
  .smilu-irr-sol-title.white { color: #FFFFFF !important; }

  .smilu-irr-sol-body {
    font-family: var(--smilu-irr-font) !important;
    font-size: 16px;
    line-height: 1.7;
    margin: 0 0 32px;
  }

  .smilu-irr-sol-body.dark { color: rgba(10,37,64,0.72) !important; }
  .smilu-irr-sol-body.white { color: rgba(255,255,255,0.72) !important; }

  .smilu-irr-feature-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .smilu-irr-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .smilu-irr-feature-check {
    width: 22px;
    height: 22px;
    background: var(--smilu-irr-green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .smilu-irr-feature-check svg {
    width: 12px;
    height: 12px;
    stroke: #FFFFFF;
    stroke-width: 2.5;
    fill: none;
  }

  .smilu-irr-feature-text {
    font-family: var(--smilu-irr-font) !important;
    font-size: 15px;
    font-weight: 500;
    color: var(--smilu-irr-navy) !important;
    line-height: 1.5;
    margin: 0;
  }

  .smilu-irr-feature-text.white { color: rgba(255,255,255,0.90) !important; }

  .smilu-irr-visual-card {
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 4/5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .smilu-irr-visual-card.navy-grad {
    background: linear-gradient(145deg, var(--smilu-irr-navy) 0%, #0D3B6E 100%);
    box-shadow: 0 40px 80px rgba(10,37,64,0.25);
  }

  .smilu-irr-visual-card.cream-grad {
    background: linear-gradient(145deg, var(--smilu-irr-cream) 0%, #EEE9DF 100%);
    box-shadow: 0 40px 80px rgba(10,37,64,0.10);
    border: 1px solid rgba(10,37,64,0.08);
  }

  .smilu-irr-visual-emoji {
    font-size: 100px;
  }

  .smilu-irr-stat-pill {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.20);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .smilu-irr-stat-pill.dark-bg {
    background: rgba(10,37,64,0.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: rgba(10,37,64,0.12);
  }

  .smilu-irr-stat-number {
    font-family: var(--smilu-irr-font) !important;
    font-size: 2rem;
    font-weight: 900;
    color: #FFFFFF !important;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .smilu-irr-stat-number.dark { color: var(--smilu-irr-navy) !important; }

  .smilu-irr-stat-label {
    font-family: var(--smilu-irr-font) !important;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255,255,255,0.80) !important;
    line-height: 1.4;
  }

  .smilu-irr-stat-label.dark { color: rgba(10,37,64,0.65) !important; }

  /* =============================================
     MÓDULO 7: GRAND SLAM OFFER STACK
     ============================================= */
  .smilu-irr-offer {
    background: var(--smilu-irr-navy);
    padding: 100px 0;
  }

  .smilu-irr-offer-pretitle {
    font-family: var(--smilu-irr-font) !important;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--smilu-irr-green) !important;
    text-align: center;
    margin: 0 0 16px;
  }

  .smilu-irr-offer-title {
    font-size: clamp(2rem, 4vw, 3.2rem) !important;
    color: #FFFFFF !important;
    text-align: center;
    margin: 0 0 16px;
  }

  .smilu-irr-offer-subtitle {
    font-family: var(--smilu-irr-font) !important;
    font-size: 17px;
    color: rgba(255,255,255,0.65) !important;
    text-align: center;
    max-width: 560px;
    margin: 0 auto 60px;
  }

  .smilu-irr-offer-box {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 28px;
    padding: 48px;
    max-width: 800px;
    margin: 0 auto;
  }

  .smilu-irr-offer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .smilu-irr-offer-row:last-of-type {
    border-bottom: none;
  }

  .smilu-irr-offer-row-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .smilu-irr-offer-row-icon {
    font-size: 28px;
  }

  .smilu-irr-offer-row-info {}

  .smilu-irr-offer-row-name {
    font-family: var(--smilu-irr-font) !important;
    font-size: 15px;
    font-weight: 700;
    color: #FFFFFF !important;
    margin: 0 0 3px;
  }

