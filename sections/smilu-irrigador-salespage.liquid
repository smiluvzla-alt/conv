    {
      "type": "text",
      "id": "hero_title",
      "label": "Título Principal del Hero",
      "default": "Avanzamos en IA, pero sigues lavando tus dientes como hace 2 siglos."
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Subtítulo del Hero",
      "default": "Tecnología sónica de 1.700 pulsos/min que arranca la placa que tu cepillo manual lleva años ignorando. Sin dañar tus encías sensibles."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "URL del CTA (si no hay producto asignado)"
    }
  ],
  "presets": [
    {
      "name": "🦷 Irrigador Salespage"
    }
  ]
}
{% endschema %}
