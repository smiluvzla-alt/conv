{% schema %}
{
  "name": "IM8 Hero & BuyBox",
  "tag": "section",
  "class": "smilu-im8-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "El estándar clínico para tu boca."
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Tecnología sónica diseñada para eliminar la placa bacteriana sin destruir tu esmalte. Una rutina de lujo."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Render 3D (Transparent PNG/WebP)"
    }
  ],
  "presets": [
    {
      "name": "IM8 Hero & BuyBox"
    }
  ]
}
{% endschema %}

<style>
  :root {
    --sm-im8-bg: #FFFFFF; /* Pure White Surface */
    --sm-im8-surface: #F8FAFC; /* Soft Blue-Grey Surface */
    --sm-im8-text: #0B2033; /* Dark Navy, NO BLACK */
    --sm-brand-cyan: #00C2FF; /* Smilu Bright Cyan */
  }

  .im8-hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: var(--sm-im8-bg);
    color: var(--sm-im8-text) !important;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 24px 60px;
    overflow: hidden;
  }

  /* Deep subtle clinical glow */
  .im8-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80vw;
    height: 80vw;
    background: radial-gradient(circle, rgba(0,194,255,0.05) 0%, rgba(255,255,255,0) 60%);
    z-index: 0;
    pointer-events: none;
  }

  .im8-hero-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 60px;
    width: 100%;
    max-width: 1200px;
    z-index: 2;
    align-items: center;
  }

  /* Left Side: Product and Text */
  .im8-hero-visual {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .im8-hero-title {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-size: clamp(3rem, 6vw, 5.5rem) !important;
    font-weight: 900 !important;
    line-height: 1.05 !important;
    letter-spacing: -0.04em !important;
    color: var(--sm-im8-text) !important;
    margin: 0 0 24px 0;
  }

  .im8-hero-subtitle {
    font-size: 1.25rem !important;
    font-weight: 400 !important;
    color: #475569 !important;
    max-width: 500px;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  /* 3D Product Image Placeholder */
  .im8-product-container {
    width: 100%;
    height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border: 1px dashed rgba(0, 194, 255, 0.4);
    border-radius: 16px;
    background: rgba(0, 194, 255, 0.03);
  }

  .im8-product-img {
    max-width: 100%;
    max-height: 120%; /* Allows it to overflow its container slightly */
    object-fit: contain;
    transform: translateY(0);
    transition: transform 0.5s ease-out;
    animation: floatIM8 6s ease-in-out infinite;
  }

  .im8-placeholder-text {
    position: absolute;
    color: var(--sm-brand-cyan) !important;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
  }

  @keyframes floatIM8 {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
    100% { transform: translateY(0px); }
  }

  /* Right Side: Buy Box */
  .im8-hero-buybox-container {
    width: 100%;
  }

  @media (max-width: 1024px) {
    .im8-hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .im8-hero-visual {
      align-items: center;
      text-align: center;
    }
    .im8-product-container {
      height: 400px;
    }
  }
</style>

<div class="im8-hero-wrapper">
  <div class="im8-glow"></div>
  <div class="im8-hero-grid">
    
    <!-- Left: Story & Visual -->
    <div class="im8-hero-visual">
      <h1 class="im8-hero-title">{{ section.settings.hero_title }}</h1>
      <p class="im8-hero-subtitle">{{ section.settings.hero_subtitle }}</p>
      
      <div class="im8-product-container">
        {% if section.settings.product_image != blank %}
          <img src="{{ section.settings.product_image | image_url: width: 800 }}" class="im8-product-img" alt="Smilü Product" fetchpriority="high">
        {% else %}
          <img src="{{ 'smilu_hero.webp' | asset_url }}" class="im8-product-img" alt="Smilü Product" fetchpriority="high">
        {% endif %}
      </div>
    </div>

    <!-- Right: High-Density Buy Box -->
    <div class="im8-hero-buybox-container">
      {% render 'smilu-im8-buybox' %}
    </div>

  </div>
</div>
