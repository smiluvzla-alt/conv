{% schema %}
{
  "name": "Smilu Home - Conexión",
  "tag": "section",
  "class": "smilu-home-section",
  "settings": [
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Párrafo Principal (Grande)",
      "default": "Pagar cientos de dólares por un cepillo que se corrompe por dentro en 3 meses es un robo."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Párrafo Secundario",
      "default": "La industria de la higiene nos ha engañado haciéndonos creer que la placa y el mal aliento matutino son normales, mientras nos obligan a comprar plástico desechable cada mes. Smilu nace para destruir esa mentira."
    }
  ],
  "presets": [
    {
      "name": "Smilu Home - Conexión"
    }
  ]
}
{% endschema %}

<style>
  .smilu-connection-wrapper {
    background-color: var(--smilu-gray-light, #F8FAFC);
    padding: 120px 20px;
    display: flex;
    justify-content: center;
  }
  .smilu-connection-content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .smilu-connection-p1 {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-weight: 900 !important;
    font-size: clamp(2rem, 5vw, 3.5rem) !important;
    line-height: 1.1 !important;
    letter-spacing: -0.04em !important;
    color: var(--smilu-text-dark, #050505) !important;
    margin: 0;
  }
  .scroll-word {
    color: #CBD5E1;
    transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .scroll-word.illuminated {
    color: #050505;
  }
  .smilu-connection-p2 {
    font-family: var(--font-family, -apple-system, sans-serif) !important;
    font-weight: 500 !important;
    font-size: clamp(1.1rem, 2vw, 1.4rem) !important;
    line-height: 1.6 !important;
    color: #64748B !important;
    margin: 0;
    max-width: 90%;
  }
  .smilu-connection-divider {
    width: 60px;
    height: 4px;
    background-color: var(--smilu-primary, #00D4FF);
    border-radius: 2px;
  }
  @media (max-width: 768px) {
    .smilu-connection-wrapper {
      padding: 80px 20px;
    }
    .smilu-connection-p2 {
      max-width: 100%;
    }
  }
</style>

<div class="smilu-connection-wrapper">
  <div class="smilu-connection-content">
    <div class="smilu-connection-divider"></div>
    <h2 class="smilu-connection-p1">{{ section.settings.paragraph_1 }}</h2>
    <p class="smilu-connection-p2">{{ section.settings.paragraph_2 }}</p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const p1 = document.querySelector('.smilu-connection-p1');
    if (p1) {
      // Split text into words and wrap in spans
      const text = p1.textContent;
      p1.innerHTML = text.split(' ').map(word => `<span class="scroll-word">${word}</span>`).join(' ');

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const words = entry.target.querySelectorAll('.scroll-word');
            words.forEach((word, idx) => {
              setTimeout(() => { word.classList.add('illuminated'); }, idx * 80);
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3 });
      
      observer.observe(p1);
    }
  });
</script>
