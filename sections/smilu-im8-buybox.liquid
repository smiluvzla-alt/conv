{% schema %}
{
  "name": "Smilü IM8 BuyBox",
  "tag": "section",
  "class": "smilu-im8-buybox-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Imagen del Producto"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto del Badge Superior",
      "default": "LA NUEVA ERA SÓNICA"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titular",
      "default": "Smilü V1 Pro"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción Corta",
      "default": "El único cepillo diseñado con materiales clínicos anti-bacterianos para destruir el origen del mal aliento sin acumular moho."
    },
    {
      "type": "number",
      "id": "price",
      "label": "Precio Numérico (USD/CLP)",
      "default": 89000
    }
  ],
  "presets": [
    {
      "name": "Smilü IM8 BuyBox"
    }
  ]
}
{% endschema %}

<style>
  :root {
    --sm-bg-dark: #0A0A0C;
    --sm-bg-card: rgba(15, 23, 42, 0.6);
    --sm-blue: #005CFF;
    --sm-blue-hover: #004BCC;
    --sm-trust: #00B67A;
    --sm-text-main: #FFFFFF;
    --sm-text-muted: #94A3B8;
  }

  /* IM8 Layout Structure */
  .im8-pdp-container {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(60px, 8vw, 100px) clamp(20px, 4vw, 40px);
    background-color: var(--sm-bg-dark);
    color: var(--sm-text-main);
  }

  /* Left Side: Massive Image */
  .im8-visual-pane {
    position: sticky;
    top: 100px;
    height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, rgba(0,92,255,0.1) 0%, transparent 70%);
    border-radius: 32px;
    overflow: hidden;
  }

  .im8-visual-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Right Side: Dense Buy Box */
  .im8-buybox-pane {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-bottom: 80px;
  }

  /* Header & Title */
  .im8-badge {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--sm-text-muted);
    text-transform: uppercase;
    width: max-content;
  }

  .im8-title {
    font-family: var(--font-serif, -apple-system, sans-serif);
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--sm-text-main) !important;
  }

  .im8-desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--sm-text-muted) !important;
    margin: 0;
  }

  /* Sticky Buy Card (Glassmorphism) */
  .im8-sticky-card {
    background: var(--sm-bg-card);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 100px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.4);
  }

  /* Price & Stock */
  .im8-price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .im8-price {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--sm-text-main) !important;
  }

  .im8-stock-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #F87171 !important;
  }

  .im8-pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #F87171;
    border-radius: 50%;
    animation: pulseRed 1.5s infinite;
  }

  @keyframes pulseRed {
    0% { box-shadow: 0 0 0 0 rgba(248, 113, 113, 0.7); }
    70% { box-shadow: 0 0 0 10px rgba(248, 113, 113, 0); }
    100% { box-shadow: 0 0 0 0 rgba(248, 113, 113, 0); }
  }

  /* MercadoPago Banner */
  .im8-mp-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 158, 227, 0.1);
    border: 1px solid rgba(0, 158, 227, 0.2);
    border-radius: 12px;
    padding: 12px 16px;
  }
  .im8-mp-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: #38BDF8 !important;
  }
  .im8-mp-logo {
    height: 20px;
  }

  /* The Button (Rule 27) */
  .im8-cta-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--sm-blue) !important;
    border-radius: 16px;
    padding: 18px 24px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 10px 30px rgba(0, 92, 255, 0.3);
    cursor: pointer;
    border: none;
  }
  .im8-cta-btn:hover {
    background: var(--sm-blue-hover) !important;
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(0, 92, 255, 0.4);
  }
  .im8-cta-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--sm-text-main) !important;
  }
  .im8-cta-sub {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.7) !important;
    margin-top: 4px;
  }

  /* Trustpilot Integration */
  .im8-trust-cluster {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }
  .im8-stars {
    display: flex;
    gap: 4px;
  }
  .im8-stars svg {
    width: 20px;
    height: 20px;
    fill: var(--sm-trust);
  }
  .im8-trust-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sm-text-main) !important;
  }
  .im8-trust-sub {
    font-size: 0.75rem;
    color: var(--sm-text-muted) !important;
  }

  /* Feature List */
  .im8-features {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 24px;
  }
  .im8-feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .im8-feature-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    color: var(--sm-trust);
  }
  .im8-feature-text {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sm-text-main) !important;
  }

  @media (max-width: 1024px) {
    .im8-pdp-container {
      grid-template-columns: 1fr;
      padding-top: 40px;
    }
    .im8-visual-pane {
      position: relative;
      top: 0;
      height: 60vh;
    }
  }
</style>

<div class="im8-pdp-container">
  <!-- Left Side: Visual Immersive Storytelling -->
  <div class="im8-visual-pane goat-card-3d">
    {% if section.settings.product_image != blank %}
      <img src="{{ section.settings.product_image | image_url: width: 1440 }}" srcset="{{ section.settings.product_image | image_url: width: 800 }} 800w, {{ section.settings.product_image | image_url: width: 1440 }} 1440w" alt="{{ section.settings.product_image.alt | escape }}" class="im8-visual-img" fetchpriority="high">
    {% else %}
      <img src="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-product-1_large.png?format=webp" alt="Smilu Product" class="im8-visual-img">
    {% endif %}
  </div>

  <!-- Right Side: Hyper-Dense Buy Box -->
  <div class="im8-buybox-pane">
    <div>
      <span class="im8-badge">{{ section.settings.badge_text }}</span>
      <h1 class="im8-title" style="margin-top: 16px; margin-bottom: 16px;">{{ section.settings.headline }}</h1>
      <p class="im8-desc">{{ section.settings.description }}</p>
    </div>

    <!-- The Sticky Card -->
    <div class="im8-sticky-card">
      
      <!-- Price & Stock -->
      <div class="im8-price-row">
        <span class="im8-price">${{ section.settings.price | divided_by: 100 }}</span>
        {% assign sec = 'now' | date: '%S' | modulo: 5 | plus: 3 %}
        <div class="im8-stock-indicator">
          <div class="im8-pulse-dot"></div>
          <span>Solo quedan {{ sec }} unidades en oferta</span>
        </div>
      </div>

      <!-- MercadoPago -->
      <div class="im8-mp-banner">
        <span class="im8-mp-text">Paga en 3 cuotas sin interés de ${{ section.settings.price | divided_by: 3 | divided_by: 100 }}</span>
        <!-- MP Logo SVG placeholder -->
        <svg viewBox="0 0 100 30" class="im8-mp-logo"><text y="20" fill="#009EE3" font-weight="bold" font-family="sans-serif">MercadoPago</text></svg>
      </div>

      <!-- Button -->
      <button class="im8-cta-btn goat-btn-magnetic">
        <span class="im8-cta-title">Añadir al Carrito 🎁</span>
        <span class="im8-cta-sub">ENVÍO INMEDIATO GRATIS 🔥</span>
      </button>

      <!-- Trustpilot -->
      <div class="im8-trust-cluster">
        <div class="im8-stars">
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <span class="im8-trust-text">Trustpilot: Excelente 4.9/5</span>
        <span class="im8-trust-sub">Basado en +12,000 sonrisas reparadas</span>
      </div>

      <!-- Bullet points -->
      <div class="im8-features">
        <div class="im8-feature-item">
          <div class="im8-feature-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <span class="im8-feature-text">Garantía Clínica de 30 Días</span>
        </div>
        <div class="im8-feature-item">
          <div class="im8-feature-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <span class="im8-feature-text">Pago 100% Encriptado (Zero Trust)</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Magnetic Button Effect
  document.addEventListener('DOMContentLoaded', () => {
    const magneticBtns = document.querySelectorAll('.goat-btn-magnetic');
    magneticBtns.forEach(btn => {
      if (window.innerWidth > 768) {
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const x = (e.clientX - rect.left - rect.width / 2) * 0.15;
          const y = (e.clientY - rect.top - rect.height / 2) * 0.15;
          btn.style.transform = `translate(${x}px, ${y}px)`;
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = 'translate(0px, 0px)';
        });
      }
    });
  });
</script>
